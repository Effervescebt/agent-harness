# Copy to .env, fill in, then load it:  set -a; source .env; set +a
# .env is git-ignored. Never commit real keys.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Only for the self-hosted experiment (a vLLM server you started yourself)
VLLM_BASE_URL=https://your-vllm-server-address/v1
VLLM_API_KEY=your-vllm-api-key-here
